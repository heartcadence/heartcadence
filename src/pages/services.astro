---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaBand from '../components/CtaBand.astro';
import { SITE } from '../site';
import allProviders from '../data/providers.json';
import { servicePages } from '../data/servicePages';
const pageFor = (id: string) => servicePages.find((p) => p.anchor === id);

type Provider = (typeof allProviders)[number];
const byName = new Map<string, Provider>(allProviders.filter((p) => p.include).map((p) => [p.name, p]));
const pick = (names: string[]) => names.map((n) => byName.get(n)).filter((p): p is Provider => Boolean(p));
const directoryLink = (area: string) => `/technology-providers/?area=${encodeURIComponent(area)}`;

// Part 1: technology and customer experience. The ids match the cards on the home page.
// "area" is the filter name used on the Technology providers page.
const techServices = [
  {
    id: 'customer-experience',
    title: 'Customer experience',
    lead: 'We look at every way customers reach you, and what happens next.',
    work: [
      'Map the journey from first contact to follow-up',
      'Find where customers wait, repeat themselves or give up',
      'Design simple processes your team can follow',
      'Choose and set up the tools that support them',
    ],
    result: 'A clear picture of your customer journey and a plan to improve it.',
    image: '/images/service-customer-experience.webp',
    area: 'Contact centre and CX',
    providers: pick(['Genesys', 'Five9', 'Talkdesk', 'NICE', 'Sprinklr']),
  },
  {
    id: 'service-desk',
    title: 'Service desk and ITSM',
    lead: 'A service desk your staff and customers can count on, built on proven IT service management (ITSM) practice.',
    work: [
      'Review your current support process, tools and ticket volumes',
      'Design ticket categories, priorities, service levels and escalation paths',
      'Set up your ITSM platform, including a self-service portal, knowledge base and asset tracking',
      'Set up incident, problem, change and request processes based on ITIL practices',
      'Build reports on response times and repeat issues',
      'Train your service desk team',
      'Arrange an outsourced help desk if you need extra coverage',
    ],
    note: 'We are an authorized ManageEngine reseller.',
    image: '/images/service-service-desk.webp',
    result: 'Faster fixes, fewer repeat tickets, and clear numbers on how your support is doing.',
    area: '',
    providers: pick(['ManageEngine']),
  },
  {
    id: 'phones-contact-centre',
    title: 'Phones and contact centre',
    lead: 'Business phones (UCaaS), contact centre (CCaaS), call recording, chat, text and AI agents.',
    work: [
      'Review your current setup and costs',
      'Compare options that fit your size and budget',
      'Manage number transfers and setup',
      'Train your team',
      'Stay your point of contact',
    ],
    result: 'A phone and contact centre setup that fits how your team works.',
    image: '/images/service-phones-contact-centre.webp',
    area: 'Unified communications',
    providers: pick(['RingCentral', 'Zoom', '8x8', 'Dialpad', 'Nextiva']),
  },
  {
    id: 'networking',
    title: 'Networks and connectivity',
    lead: 'Internet, backup connections and secure networks for every location.',
    work: [
      'Fibre and business internet',
      '4G and 5G backup',
      'SD-WAN and SASE',
      'Managed Wi-Fi',
      'Replacing old copper phone lines',
    ],
    image: '/images/service-networking.webp',
    result: 'Connections that stay up, with one contact when something goes wrong.',
    area: 'Networking and connectivity',
    providers: pick(['Cisco', 'Lumen', 'Rogers Communications', 'Zayo', 'Cato Networks']),
  },
  {
    id: 'cybersecurity',
    title: 'Cybersecurity',
    lead: 'Find the gaps, close them and watch for threats.',
    work: [
      'Security assessments',
      'Managed detection and response',
      'Firewall and endpoint protection',
      'Staff training',
      'Compliance support',
      'Incident response',
    ],
    image: '/images/service-cybersecurity.webp',
    result: 'A security setup sized for your business, not a big-company price tag.',
    area: 'Cybersecurity',
    providers: pick(['eSentire', 'Field Effect', 'Akamai Technologies, Inc', 'Appgate Cybersecurity', 'Drata']),
  },
  {
    id: 'cloud-it',
    title: 'Cloud and infrastructure',
    lead: 'Cloud, data centres, backup and managed IT.',
    work: [
      'Cloud setup and migration',
      'Backup and disaster recovery',
      'Data centre and colocation',
      'Managed IT services',
      'Licence management',
    ],
    image: '/images/service-technology.webp',
    result: 'Infrastructure that runs in the background, so your team can focus on customers.',
    area: 'Cloud and managed services',
    providers: pick(['Equinix', 'Rackspace Technology', 'Pax8', 'Expedient', 'Digital Realty']),
  },
  {
    id: 'mobility-iot',
    title: 'Mobility and IoT',
    lead: 'Phones, plans and connected devices for teams on the move.',
    work: [
      'Business phones and plans',
      'Device management',
      'Cameras and access control',
      'Sensors',
      'Mobile and telecom expense management',
    ],
    image: '/images/service-mobility-iot.webp',
    result: 'Devices that are set up, tracked and paid for in one place.',
    area: 'Mobility',
    providers: pick(['T-Mobile', 'AT&T Wireless', 'KORE Wireless', 'Eseye', 'Semtech']),
  },
];



// Service details for search engines (schema.org JSON-LD).
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: techServices.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Service',
      '@id': `${SITE.url}/services/#${s.id}`,
      name: s.title,
      description: s.lead,
      url: `${SITE.url}/services/#${s.id}`,
      provider: { '@id': `${SITE.url}/#organization` },
      areaServed: { '@type': 'Country', name: 'Canada' },
    },
  })),
};
---
<Base
  title="Technology and customer experience services"
  description="Customer experience, service desk and ITSM, phones, contact centre, networks, cybersecurity, cloud and IoT for Canadian businesses."
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <PageHeader
    eyebrow="Services"
    title="Technology and customer experience services for Canadian businesses"
    intro="Technology and customer experience for Canadian businesses. Start with one service or bring us in for all of them."
  >
    <nav aria-label="Services on this page" class="mt-6">
      <ul class="flex flex-wrap gap-2">
        {techServices.map((s) => <li><a href={`#${s.id}`} class="btn-secondary">{s.title}</a></li>)}
        <li><a href="/government/" class="btn-secondary">Selling to Government</a></li>
      </ul>
    </nav>
  </PageHeader>

  <section class="container-site" aria-labelledby="tech-heading">
    <h2 id="tech-heading" class="sr-only">Technology and customer experience</h2>
    <div class="grid gap-6">
      {techServices.map((s) => (
        <section id={s.id} class="scroll-mt-6 card-hover rounded-[var(--radius-md)] bg-surface border border-border p-6 md:p-10 md:grid md:grid-cols-[1fr_1.3fr] md:gap-10">
          <div>
            <h2>{s.title}</h2>
            <p class="mt-3 text-lg">{s.lead}</p>
            {pageFor(s.id) && (
              <p class="mt-4"><a href={`/services/${pageFor(s.id)!.slug}/`} class="btn-secondary">Learn more<span class="sr-only"> about {s.title.toLowerCase()}</span></a></p>
            )}
            {s.image && (
              <img src={s.image} alt="" width="800" height="598" loading="lazy" decoding="async" class="mt-6 h-auto w-full max-w-xs" />
            )}
          </div>
          <div class="mt-6 md:mt-0">
            <h3 class="text-lg">What we do</h3>
            <ul class="mt-2 list-disc pl-5 grid gap-1">
              {s.work.map((w) => <li>{w}</li>)}
            </ul>
            {s.note && <p class="mt-4 font-semibold">{s.note}</p>}
            {s.providers.length > 0 && (
              <>
                <h3 class="text-lg mt-6">Providers we work with</h3>
                {s.providers.length === 1 ? (
                  <div class="logo-tile mt-3 inline-flex h-20 items-center justify-center rounded-[var(--radius-sm)] border border-border px-6">
                    <img src={s.providers[0].logo} alt={`${s.providers[0].name} logo`} width={s.providers[0].width} height={s.providers[0].height} loading="lazy" decoding="async" class="h-8 w-auto" />
                  </div>
                ) : (
                  <ul class="mt-3 grid grid-cols-3 gap-2 sm:grid-cols-5">
                    {s.providers.map((p) => (
                      <li class="logo-tile flex h-14 items-center justify-center rounded-[var(--radius-sm)] border border-border p-2">
                        <img src={p.logo} alt={`${p.name} logo`} width={p.width} height={p.height} loading="lazy" decoding="async" class="max-h-10 w-auto max-w-full object-contain" />
                      </li>
                    ))}
                  </ul>
                )}
                {s.area && (
                  <p class="mt-3"><a href={directoryLink(s.area)}>See more {s.title === 'Mobility and IoT' ? 'mobility and IoT' : s.title.toLowerCase()} providers</a></p>
                )}
              </>
            )}
            <h3 class="text-lg mt-6">What you get</h3>
            <p class="mt-2">{s.result}</p>
          </div>
        </section>
      ))}
    </div>
  </section>

  <CtaBand title="Not sure where to start?" text="Book a call. We will help you figure out which service fits where you are today." />
</Base>

<style>
  /* Logos keep their own colours, so tiles stay light in both themes. */
  .logo-tile { background: #FFFFFF; }
</style>
