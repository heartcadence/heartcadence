---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaBand from '../components/CtaBand.astro';

const services = [
  {
    id: 'readiness',
    title: 'Procurement readiness',
    lead: 'Getting ready before the right opportunity appears, so you are not rushing when it does.',
    work: [
      'Review your registrations, such as your Procurement Business Number and supplier profiles',
      'Gather the documents buyers often ask for, such as insurance, policies and past work summaries',
      'Find gaps in your processes and fix them',
      'Set up a simple way to track opportunities that fit your business',
      'Review your security practices and arrange an assessment if buyers will expect one',
    ],
    result: 'A clear picture of where you stand, and the pieces in place to bid with confidence.',
  },
  {
    id: 'bids',
    title: 'Bid and proposal development',
    lead: 'Stronger, clearer responses that answer what the buyer actually asked.',
    work: [
      'Help you decide whether a bid is worth pursuing',
      'Break down the requirements and build a response plan',
      'Write and edit bid sections with your team',
      'Check the response against every requirement before you submit',
      'Manage the bid schedule so nothing is late',
    ],
    result: 'A complete, compliant, well-written bid, submitted on time.',
  },
  {
    id: 'technology',
    title: 'Technology sourcing and setup',
    lead: 'We work with a network of technology providers. We review what your contract needs, compare options, and manage the setup with you. You get one point of contact instead of five vendors.',
    work: [
      'Review your current systems and what a contract will need',
      'Compare options from our provider network that fit your size and budget',
      'Manage the setup with the provider and your team',
      'Stay your main point of contact once the service is running',
    ],
    categories: [
      { name: 'Cybersecurity', items: 'assessments, managed security, staff training, incident response' },
      { name: 'Cloud and IT management', items: 'cloud setup and migration, backup and recovery, helpdesk, licence management' },
      { name: 'Networking and connectivity', items: 'internet, SD-WAN, managed Wi-Fi, network security' },
      { name: 'Phone and contact centre', items: 'business phone systems, contact centre, call recording' },
      { name: 'Mobile devices', items: 'phones, plans, device management' },
      { name: 'Sensors and physical security', items: 'cameras, access control, IoT monitoring' },
    ],
    result: 'Technology that supports delivery, instead of getting in the way.',
  },
  {
    id: 'customer-experience',
    title: 'Customer experience and delivery',
    lead: 'Delivering the contract well, so the buyer wants to work with you again.',
    work: [
      'Map the journey your clients go through, from first contact to final report',
      'Design processes that make your work easy to receive and easy to trust',
      'Choose and set up the phone, chat and contact centre tools your clients use to reach you',
      'Improve how your business runs day to day',
      'Plan and manage contract delivery, with clear milestones',
    ],
    result: 'Smooth delivery and a better experience for the people you serve.',
  },
];

// Illustrations by service id. Add a line here as each image is ready.
// The images are decorative, so they use empty alt text. The heading beside each one already says what it is.
const images: Record<string, string> = {
  readiness: '/images/service-readiness.webp',
  bids: '/images/service-bids.webp',
  technology: '/images/service-technology.webp',
  'customer-experience': '/images/service-customer-experience.webp',
};
---
<Base title="Services" description="Procurement readiness, bid and proposal development, technology sourcing and setup, and customer experience services for Canadian businesses selling to government.">
  <PageHeader
    eyebrow="Services"
    title="Hands-on help, from first registration to final delivery"
    intro="We work alongside your team in four areas. You can start with one or bring us in for all of them."
  >
    <nav aria-label="Services on this page" class="mt-6">
      <ul class="flex flex-wrap gap-2">
        {services.map((s) => <li><a href={`#${s.id}`} class="btn-secondary">{s.title}</a></li>)}
      </ul>
    </nav>
  </PageHeader>

  <div class="container-site grid gap-6">
    {services.map((s) => (
      <section id={s.id} class="scroll-mt-6 card-hover rounded-[var(--radius-md)] bg-surface border border-border p-6 md:p-10 md:grid md:grid-cols-[1fr_1.3fr] md:gap-10">
        <div>
          <h2>{s.title}</h2>
          <p class="mt-3 text-lg">{s.lead}</p>
          {images[s.id] && (
            <img src={images[s.id]} alt="" width="1600" height="1195" loading="lazy" decoding="async" class="mt-6 h-auto w-full max-w-xs" />
          )}
        </div>
        <div class="mt-6 md:mt-0">
          <h3 class="text-lg">What we do</h3>
          <ul class="mt-2 list-disc pl-5 grid gap-1">
            {s.work.map((w) => <li>{w}</li>)}
          </ul>
          {s.categories && (
            <>
              <h3 class="text-lg mt-6">What we can source</h3>
              <ul class="mt-2 list-disc pl-5 grid gap-1">
                {s.categories.map((c) => <li><strong class="font-semibold">{c.name}:</strong> {c.items}</li>)}
              </ul>
            </>
          )}
          <h3 class="text-lg mt-6">What you get</h3>
          <p class="mt-2">{s.result}</p>
        </div>
      </section>
    ))}
  </div>

  <CtaBand title="Not sure where to start?" text="Book a call. We will help you figure out which service fits where you are today." />
</Base>
