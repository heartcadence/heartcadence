---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import allProviders from '../../data/providers.json';
import { servicePages, type ServicePage } from '../../data/servicePages';
import { scorecardForServicePage } from '../../data/scorecards';
import { SITE } from '../../site';

export function getStaticPaths() {
  return servicePages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props as { page: ServicePage };

type Provider = (typeof allProviders)[number];
const byName = new Map<string, Provider>(allProviders.filter((p) => p.include).map((p) => [p.name, p]));
const providers = page.providers.map((n) => byName.get(n)).filter((p): p is Provider => Boolean(p));
const pageUrl = `${SITE.url}/services/${page.slug}/`;
const scorecard = scorecardForServicePage(`/services/${page.slug}/`);

// Search engine data: the service, its questions and answers, and where it sits in the site.
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${pageUrl}#service`,
      name: page.heading,
      description: page.intro,
      url: pageUrl,
      provider: { '@id': `${SITE.url}/#organization` },
      areaServed: { '@type': 'Country', name: 'Canada' },
    },
    {
      '@type': 'FAQPage',
      mainEntity: page.faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
        { '@type': 'ListItem', position: 2, name: 'Services', item: `${SITE.url}/services/` },
        { '@type': 'ListItem', position: 3, name: page.heading, item: pageUrl },
      ],
    },
  ],
};
---
<Base title={page.title} description={page.description}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <nav aria-label="Breadcrumb" class="container-site pt-6 text-sm">
    <ol class="flex flex-wrap gap-2 text-text-muted">
      <li><a href="/services/">Services</a></li>
      <li aria-hidden="true">/</li>
      <li aria-current="page">{page.heading}</li>
    </ol>
  </nav>

  <section class="container-site pt-6 pb-10 md:grid md:grid-cols-[1.4fr_1fr] md:items-center md:gap-10">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wider text-text-muted mb-3">Services</p>
      <h1 class="max-w-3xl">{page.heading}</h1>
      <p class="mt-4 max-w-2xl text-lg">{page.intro}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/book-a-call/" class="btn-primary">Book a call</a>
        {scorecard && <a href={`/scorecards/${scorecard.slug}/`} class="btn-secondary">Take the free scorecard</a>}
        <a href="#questions" class="btn-secondary">Common questions</a>
      </div>
    </div>
    <img src={page.image} alt="" width="800" height="598" decoding="async" class="hidden md:block h-auto w-full max-w-sm justify-self-center" />
  </section>

  <section class="container-site grid gap-6 md:grid-cols-2">
    <div class="card-hover rounded-[var(--radius-md)] bg-surface-alt border border-border p-6 md:p-8">
      <h2 class="text-2xl">Signs you need help</h2>
      <ul class="mt-4 list-disc pl-5 grid gap-2">
        {page.signs.map((s) => <li>{s}</li>)}
      </ul>
    </div>
    <div class="card-hover rounded-[var(--radius-md)] bg-surface border border-border p-6 md:p-8">
      <h2 class="text-2xl">What we do</h2>
      <ul class="mt-4 list-disc pl-5 grid gap-2">
        {page.work.map((w) => <li>{w}</li>)}
      </ul>
      {page.toolsNote && <p class="mt-4 font-semibold">{page.toolsNote}</p>}
    </div>
  </section>

  <section class="container-site mt-16" aria-labelledby="how-heading">
    <h2 id="how-heading">How it works</h2>
    <ol class="mt-6 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
      {page.steps.map((s, i) => (
        <li class="card-hover rounded-[var(--radius-md)] bg-surface border border-border p-6">
          <p class="text-sm font-semibold text-text-muted">Step {i + 1}</p>
          <h3 class="mt-1">{s.title}</h3>
          <p class="mt-2">{s.text}</p>
        </li>
      ))}
    </ol>
  </section>

  {providers.length > 0 && (
    <section class="container-site mt-16" aria-labelledby="providers-heading">
      <h2 id="providers-heading">Providers we work with</h2>
      <ul class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
        {providers.map((p) => (
          <li class="logo-tile flex h-20 items-center justify-center rounded-[var(--radius-sm)] border border-border px-4">
            <img src={p.logo} alt={`${p.name} logo`} width={p.width} height={p.height} loading="lazy" decoding="async" class="max-h-10 w-auto max-w-full object-contain" />
          </li>
        ))}
      </ul>
      {page.area && (
        <p class="mt-4"><a href={`/technology-providers/?area=${encodeURIComponent(page.area)}`}>See more {page.areaLabel} providers</a></p>
      )}
    </section>
  )}

  <section class="container-site mt-16" aria-labelledby="lead-heading">
    <div class="card-hover rounded-[var(--radius-md)] bg-surface border border-border p-6 md:p-8 max-w-3xl">
      <h2 id="lead-heading" class="text-2xl">Who leads this work</h2>
      <p class="mt-4 text-lg font-semibold text-heading">{page.lead.name}</p>
      <p class="text-text-muted">{page.lead.role}</p>
      <p class="mt-3">{page.lead.text}</p>
      {page.lead.certs && (
        <>
          <h3 class="mt-4 text-base">Active certifications</h3>
          <ul class="mt-1 list-disc pl-5 grid gap-1">
            {page.lead.certs.map((c) => <li>{c}</li>)}
          </ul>
        </>
      )}
      <p class="mt-4"><a href="/about/">Meet the team</a></p>
    </div>
  </section>

  <section id="questions" class="scroll-mt-6 container-site mt-16" aria-labelledby="faq-heading">
    <h2 id="faq-heading">Common questions</h2>
    <div class="mt-6 grid gap-3 max-w-3xl">
      {page.faqs.map((f) => (
        <details class="rounded-[var(--radius-md)] bg-surface border border-border p-5">
          <summary class="cursor-pointer font-semibold text-heading">{f.q}</summary>
          <p class="mt-3">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <CtaBand title={page.cta.title} text={page.cta.text} />
</Base>

<style>
  /* Logos keep their own colours, so tiles stay light in both themes. */
  .logo-tile { background: #FFFFFF; }
</style>
