---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
---
<Base title="Page not found">
  <PageHeader title="We could not find that page" intro="The link may be old, or the address may have a typo.">
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/" class="btn-primary">Go to the home page</a>
      <a href="/services/" class="btn-secondary">See our services</a>
    </div>
  </PageHeader>
</Base>
