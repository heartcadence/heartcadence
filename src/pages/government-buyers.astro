---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { SITE } from '../site';

const details = [
  ['Legal name', 'Heart Cadence Inc.'],
  ['Location', 'Brantford, Ontario. Serving clients across Canada.'],
  ['Procurement Business Number (PBN)', SITE.pbn],
  ['Language of service', 'English'],
  ['Contact', SITE.email],
];

const status = [
  ['Contract Security Program clearance', 'Planned'],
  ['Supply arrangements, such as TBIPS or ProServices', 'Planned'],
  ['Black business certification (BEBC)', 'Planned. Application not yet submitted.'],
];

const capabilities = [
  'Government procurement readiness',
  'Bid and proposal development',
  'Project management',
  'IT management and cloud',
  'Technology stack selection and deployment',
  'Customer experience and journey design',
  'Business process improvement',
];
---
<Base title="For government buyers" description="Company details, Procurement Business Number, capabilities and registration status for Heart Cadence Inc.">
  <PageHeader
    eyebrow="For government buyers"
    title="Who we are, at a glance"
    intro="This page is for procurement staff who want to confirm who we are and whether we can deliver. If you need anything not listed here, email us."
  />

  <div class="container-site grid gap-6 lg:grid-cols-2">
    <section class="min-w-0 rounded-[var(--radius-md)] bg-surface border border-border p-6 md:p-8">
      <h2 class="text-2xl">Company details</h2>
      <dl class="mt-4 grid gap-3">
        {details.map(([k, v]) => (
          <div class="grid gap-1 sm:grid-cols-[13rem_1fr]">
            <dt class="font-semibold text-heading">{k}</dt>
            <dd>{k === 'Contact' ? <a href={`mailto:${v}`}>{v}</a> : v}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="min-w-0 rounded-[var(--radius-md)] bg-surface border border-border p-6 md:p-8">
      <h2 class="text-2xl">Registration and certification status</h2>
      <p class="mt-2 text-text-muted text-[0.9375rem]">We list only what is true today. We will update this page as each item changes.</p>
      <table class="mt-4 w-full text-left [overflow-wrap:anywhere]">
        <caption class="sr-only">Registration and certification status</caption>
        <thead>
          <tr class="border-b border-border">
            <th scope="col" class="py-2 pr-4">Item</th>
            <th scope="col" class="py-2">Status</th>
          </tr>
        </thead>
        <tbody>
          <tr class="border-b border-border">
            <th scope="row" class="py-2 pr-4 font-normal">Procurement Business Number</th>
            <td class="py-2">Issued: {SITE.pbn}</td>
          </tr>
          {status.map(([k, v]) => (
            <tr class="border-b border-border">
              <th scope="row" class="py-2 pr-4 font-normal">{k}</th>
              <td class="py-2">{v}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  </div>

  <section class="container-site mt-6 grid gap-6 lg:grid-cols-2">
    <div class="card-hover rounded-[var(--radius-md)] border border-border p-6 md:p-8">
      <h2 class="text-2xl">Capabilities</h2>
      <ul class="mt-4 list-disc pl-5 grid gap-1">
        {capabilities.map((c) => <li>{c}</li>)}
      </ul>
    </div>
    <div class="card-hover rounded-[var(--radius-md)] border border-border p-6 md:p-8">
      <h2 class="text-2xl">Capability statement</h2>
      <p class="mt-3">A one-page summary of who we are, what we do, and our registration status.</p>
      <ul class="mt-4 grid gap-3">
        <li><a href="/documents/heart-cadence-capability-statement-en.pdf" class="btn-primary" download>Download in English (PDF)</a></li>
        <li><a href="/documents/heart-cadence-enonce-de-capacites-fr.pdf" class="btn-secondary" hreflang="fr" download>Télécharger en français (PDF)</a></li>
      </ul>
    </div>
  </section>

  <section class="container-site mt-6">
    <div class="card-hover rounded-[var(--radius-md)] border border-border p-6 md:p-8">
      <h2 class="text-2xl">Experience</h2>
      <p class="mt-3 max-w-3xl">
        Heart Cadence Inc. is a new company. We do not yet have completed government contracts to list. Our team brings about 20 years of IT experience and deep expertise in customer experience and journey design. We will add past performance here as it happens, and never before.
      </p>
    </div>
  </section>

  <section class="container-site mt-6 grid gap-6 lg:grid-cols-2">
    <div id="conflict-of-interest" class="scroll-mt-6 rounded-[var(--radius-md)] bg-surface-alt border border-border p-6 md:p-8">
      <h2 class="text-2xl">Conflict of interest policy</h2>
      <ul class="mt-4 list-disc pl-5 grid gap-2">
        <li>We do not lobby or contact public officials on behalf of clients.</li>
        <li>We do not work on competing bids for the same opportunity.</li>
        <li>We disclose any relationship that could create a real or perceived conflict before we accept work.</li>
        <li>We do not use confidential information from one client or buyer to benefit another.</li>
        <li>If a conflict arises during an engagement, we tell everyone affected and step back where needed.</li>
      </ul>
    </div>
    <div class="card-hover rounded-[var(--radius-md)] bg-surface-alt border border-border p-6 md:p-8">
      <h2 class="text-2xl">What we don't do</h2>
      <ul class="mt-4 list-disc pl-5 grid gap-2">
        <li>No lobbying.</li>
        <li>No promises of contract wins.</li>
        <li>No claims of insider access or government connections.</li>
      </ul>
    </div>
  </section>
</Base>
