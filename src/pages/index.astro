---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';

const services = [
  {
    href: '/services/#readiness',
    title: 'Procurement readiness',
    text: 'We get your registrations, documents and internal processes in order, so you are ready when the right opportunity appears.',
  },
  {
    href: '/services/#bids',
    title: 'Bid and proposal development',
    text: 'We help you decide which bids to pursue, then plan, write and review the response with you, start to finish.',
  },
  {
    href: '/services/#technology',
    title: 'Technology and cloud',
    text: 'We choose, set up and manage the tools a public sector contract needs, from IT systems to cloud services.',
  },
  {
    href: '/services/#customer-experience',
    title: 'Customer experience and delivery',
    text: 'We design how your clients experience your work and help you deliver the contract on time and as promised.',
  },
];

const steps = [
  { title: 'Fit call', text: 'A short call to understand your business and goals.' },
  { title: 'Readiness review', text: 'We look at where you stand today and what is missing.' },
  { title: 'Plan', text: 'A clear plan with tasks, owners and dates.' },
  { title: 'Do the work', text: 'We build, write and set up alongside your team.' },
];
---
<Base title="Home">
  <section class="container-site pt-12 pb-12 md:pt-20 md:pb-16">
    <p class="text-sm font-semibold uppercase tracking-wider text-text-muted mb-4">Government contract readiness and bid support</p>
    <h1 class="max-w-3xl">Become government-ready, with a team that does the work.</h1>
    <p class="mt-5 max-w-2xl text-lg">
      Heart Cadence Inc. (HCI) helps Canadian businesses become government-ready, submit stronger bids, and deliver public sector contracts with confidence.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/book-a-call/" class="btn-primary">Book a call</a>
      <a href="/services/" class="btn-secondary">See our services</a>
    </div>
    <p class="mt-6 text-sm text-text-muted">Based in Brantford, Ontario. Working with businesses across Canada.</p>
  </section>

  <section class="bg-surface border-y border-border">
    <div class="container-site py-14 grid gap-10 md:grid-cols-2">
      <div>
        <h2>Who we help</h2>
        <p class="mt-4">
          We work with vendors and subcontractors who want to grow by selling to government. Most of our focus is on IT services and professional services firms.
        </p>
        <p class="mt-4">
          You may be new to public sector work, or you may have bid before without the results you wanted. Either way, we start from where you are.
        </p>
      </div>
      <div>
        <h2>What makes us different</h2>
        <p class="mt-4">
          Many advisors tell you what to do. We do the work with you. That means writing bid sections, setting up systems, and mapping your client journey, not handing you a report.
        </p>
        <p class="mt-4">
          Our team brings about 20 years of IT experience and deep customer experience expertise to every engagement.
        </p>
      </div>
    </div>
  </section>

  <section class="container-site py-14">
    <h2>What we do</h2>
    <ul class="mt-8 grid gap-4 md:grid-cols-2">
      {services.map((s) => (
        <li class="rounded-[var(--radius-md)] bg-surface border border-border p-6">
          <h3><a href={s.href} class="text-heading no-underline hover:text-link">{s.title}</a></h3>
          <p class="mt-2">{s.text}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="bg-surface-alt border-y border-border">
    <div class="container-site py-14 md:grid md:grid-cols-[1fr_1.4fr] md:gap-12">
      <h2>Free help is a good start. We go further.</h2>
      <div class="mt-4 md:mt-0">
        <p>
          Procurement Assistance Canada offers free seminars, resources and coaching. We recommend them. Their help explains the process. It does not write your bid or set up your systems.
        </p>
        <p class="mt-4">HCI adds hands-on work on top of that:</p>
        <ul class="mt-3 list-disc pl-5 grid gap-1">
          <li>Writing and reviewing your bid with you, for a specific opportunity</li>
          <li>Choosing and setting up the technology a contract needs</li>
          <li>Designing a client experience that supports strong delivery</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="container-site py-14">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2>How we work</h2>
      <a href="/how-we-work/" class="font-semibold">See the full process</a>
    </div>
    <ol class="mt-8 grid gap-4 md:grid-cols-4">
      {steps.map((s, i) => (
        <li class="rounded-[var(--radius-md)] border border-border p-6">
          <p class="text-sm font-semibold text-text-muted">Step {i + 1}</p>
          <h3 class="mt-1">{s.title}</h3>
          <p class="mt-2">{s.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="container-site">
    <div class="rounded-[var(--radius-md)] border border-border p-8">
      <h2>What we don't do</h2>
      <ul class="mt-4 list-disc pl-5 grid gap-2 max-w-2xl">
        <li>We do not lobby or contact public officials on your behalf.</li>
        <li>We do not promise contract wins. No one honestly can.</li>
        <li>We do not claim insider access or government connections.</li>
      </ul>
    </div>
  </section>

  <CtaBand />
</Base>
