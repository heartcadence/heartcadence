---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import allProviders from '../data/providers.json';

// Logos marked "featured" in src/data/providers.json show in the strip below.
const featured = allProviders.filter((p) => p.include && p.featured);
const providerCount = allProviders.filter((p) => p.include).length;
const countLabel = `${Math.floor(providerCount / 50) * 50}+`;

// Each card links to its Services section for now. Point these at the
// solution pages once those are written.
const areas = [
  {
    href: '/services/#customer-experience',
    title: 'Customer experience',
    text: 'We map how your customers reach you and what happens next, then fix the gaps.',
  },
  {
    href: '/services/#service-desk',
    title: 'Service desk and ITSM',
    text: 'Ticketing, self-service, service levels and ITIL-based processes, set up on a platform that fits.',
  },
  {
    href: '/services/#phones-contact-centre',
    title: 'Phones and contact centre',
    text: 'Business phone systems (UCaaS), contact centre (CCaaS), call recording and chat. We compare options and set up the one you choose.',
  },
  {
    href: '/services/#networking',
    title: 'Networks and connectivity',
    text: 'Internet, SD-WAN, managed Wi-Fi and backup connections for every location.',
  },
  {
    href: '/services/#cybersecurity',
    title: 'Cybersecurity',
    text: 'Assessments, managed security, staff training and incident response.',
  },
  {
    href: '/services/#cloud-it',
    title: 'Cloud and infrastructure',
    text: 'Cloud setup and migration, backup and recovery, data centres and managed IT.',
  },
  {
    href: '/services/#mobility-iot',
    title: 'Mobility and IoT',
    text: 'Business phones, plans, device management, cameras and sensors.',
  },
];

const reasons = [
  { title: 'Not tied to any one brand', text: 'We are loyal to your business. We recommend what fits, not what one vendor sells.' },
  { title: 'We do the work with you', text: 'We compare the options, manage the setup and stay your main contact once it is running.' },
  { title: 'One point of contact', text: 'One team instead of five vendors.' },
  { title: 'Real experience', text: 'About 20 years in IT, ITIL 4 certified service management, and deep customer experience expertise.' },
];

const steps = [
  { title: 'Fit call', text: 'A short call to understand your business and goals.' },
  { title: 'Review', text: 'We look at your current tools, costs and where customers get stuck.' },
  { title: 'Plan', text: 'A clear recommendation with options, owners and dates.' },
  { title: 'Set up and support', text: 'We manage the setup with you and stay your point of contact.' },
];
---
<Base
  title="Home"
  description="We help Canadian businesses choose, set up and run their phone, contact centre, network, security and service desk tools. One team, start to finish."
>
  <section class="container-site pt-12 pb-12 md:pt-20 md:pb-16">
    <p class="text-sm font-semibold uppercase tracking-wider text-text-muted mb-4">Technology and customer experience</p>
    <h1 class="max-w-3xl">The right technology for how your business serves its customers.</h1>
    <p class="mt-5 max-w-2xl text-lg">
      Heart Cadence Inc. (HCI) helps Canadian businesses choose, set up and run the phone, contact centre, network, security and service desk tools their teams and customers rely on. One team, from the first call to go-live.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/book-a-call/" class="btn-primary">Book a call</a>
      <a href="/technology-providers/" class="btn-secondary">See the providers we work with</a>
    </div>
    <p class="mt-6 text-sm text-text-muted">Based in Brantford, Ontario. Working with businesses across Canada.</p>
  </section>

  {featured.length > 0 && (
    <section class="bg-surface border-y border-border" aria-labelledby="providers-heading">
      <div class="container-site py-12">
        <h2 id="providers-heading">We work with {countLabel} technology providers</h2>
        <ul class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-7">
          {featured.map((p) => (
            <li class="logo-tile flex h-20 items-center justify-center rounded-[var(--radius-md)] border border-border p-3">
              <img src={p.logo} alt={`${p.name} logo`} width={p.width} height={p.height} loading="lazy" decoding="async" class="max-h-14 w-auto max-w-full object-contain" />
            </li>
          ))}
        </ul>
        <p class="mt-6"><a href="/technology-providers/" class="font-semibold">See all providers</a></p>
      </div>
    </section>
  )}

  <section class="container-site py-14">
    <div class="max-w-3xl">
      <h2>Who we help</h2>
      <p class="mt-4">
        We work with owners, IT leads and customer experience leads at small and mid-sized businesses. You may be outgrowing your phone system, managing too many vendors, or unsure which tools fit. We start from where you are.
      </p>
    </div>
  </section>

  <section class="container-site pb-14">
    <h2>What we do</h2>
    <ul class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
      {areas.map((a) => (
        <li class="card-hover rounded-[var(--radius-md)] bg-surface border border-border p-6">
          <h3><a href={a.href} class="text-heading no-underline hover:text-link">{a.title}</a></h3>
          <p class="mt-2">{a.text}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="bg-surface border-y border-border">
    <div class="container-site py-14">
      <h2>Why HCI</h2>
      <ul class="mt-8 grid gap-6 md:grid-cols-2">
        {reasons.map((r) => (
          <li>
            <h3 class="text-xl">{r.title}</h3>
            <p class="mt-2">{r.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="container-site py-14">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2>How we work</h2>
      <a href="/how-we-work/" class="font-semibold">See the full process</a>
    </div>
    <ol class="mt-8 grid gap-4 md:grid-cols-4">
      {steps.map((s, i) => (
        <li class="card-hover rounded-[var(--radius-md)] border border-border p-6">
          <p class="text-sm font-semibold text-text-muted">Step {i + 1}</p>
          <h3 class="mt-1">{s.title}</h3>
          <p class="mt-2">{s.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="bg-surface-alt border-y border-border">
    <div class="container-site py-14 md:flex md:items-center md:justify-between md:gap-10">
      <div class="max-w-2xl">
        <h2>Selling to Government?</h2>
        <p class="mt-3">
          We also help vendors and subcontractors become Government-ready and submit stronger bids. We write and review the bid with you, start to finish.
        </p>
      </div>
      <div class="mt-6 flex flex-wrap gap-3 md:mt-0 md:shrink-0">
        <a href="/government/" class="btn-secondary">How we help with Government contracts</a>
        <a href="/government-buyers/" class="btn-secondary">For Government Buyers</a>
      </div>
    </div>
  </section>

  <section class="container-site mt-14">
    <div class="card-hover rounded-[var(--radius-md)] border border-border p-8">
      <h2>What we don't do</h2>
      <ul class="mt-4 list-disc pl-5 grid gap-2 max-w-2xl">
        <li>We do not promise results we cannot control.</li>
        <li>We do not push one vendor's products.</li>
        <li>We do not lobby or contact public officials on your behalf.</li>
      </ul>
    </div>
  </section>

  <CtaBand
    title="See if we are a good fit"
    text="Book a short call. We will ask about your business, your tools and where you want to be. You will leave with clear next steps, whether or not we work together."
  />
</Base>

<style>
  /* Logos keep their own colours, so tiles stay light in both themes. */
  .logo-tile { background: #FFFFFF; }
</style>
