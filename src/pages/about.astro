---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaBand from '../components/CtaBand.astro';

const people = [
  {
    name: 'Jason K. McEwan',
    initials: 'JM',
    role: 'Founder and Principal Consultant',
    photo: '/images/jason-mcewan.webp',
    bio: 'Jason has about 20 years of experience in IT, with deep expertise in service desk and IT service management (ITSM). He holds active ITIL 4 Foundation, Create, Deliver and Support (CDS), and Direction, Plan and Improve (DPI) certifications. He leads technology, service desk and Government contract work for HCI clients.',
  },
  {
    name: 'Rory Stennett',
    initials: 'RS',
    role: 'Director, Client Experience and Growth',
    photo: '/images/rory-stennett.webp',
    bio: 'Rory is an expert in customer experience and customer journey design. Rory helps clients shape how customers experience their business, so those customers want to come back.',
  },
];
---
<Base title="About" description="Meet the team at Heart Cadence Inc., a Canadian firm helping businesses with technology, customer experience and Government contracts.">
  <PageHeader
    eyebrow="About"
    title="A small team that does the work"
    intro="Heart Cadence Inc. (HCI) is based in Brantford, Ontario, and works with businesses across Canada. We help businesses choose, set up and run the technology their teams and customers rely on. We also help vendors and subcontractors win and deliver Government contracts."
  />

  <section class="container-site">
    <h2 class="sr-only">Our team</h2>
    <ul class="grid gap-6 md:grid-cols-2">
      {people.map((p) => (
        <li class="card-hover rounded-[var(--radius-md)] bg-surface border border-border p-6 md:p-8">
          <div class="flex items-center gap-4">
            {p.photo ? (
              <img src={p.photo} alt={`Photo of ${p.name}`} width="96" height="96" loading="lazy" decoding="async" class="w-24 h-24 shrink-0 rounded-full object-cover border border-border" />
            ) : (
              <div class="w-24 h-24 shrink-0 rounded-full bg-surface-alt border border-border flex items-center justify-center font-serif text-2xl font-semibold text-heading" role="img" aria-label={`Photo of ${p.name} coming soon`}>{p.initials}</div>
            )}
            <div>
              <h3>{p.name}</h3>
              <p class="text-text-muted">{p.role}</p>
            </div>
          </div>
          <p class="mt-4">{p.bio}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="container-site mt-16 grid gap-6 md:grid-cols-2">
    <div>
      <h2>Why we started HCI</h2>
      <p class="mt-4">
        Smaller businesses often buy technology from whoever calls first, then spend years living with the wrong fit. Government work has the same problem: the process is hard to learn alone. We started HCI to give smaller firms a team that compares the options honestly and does the work with them.
      </p>
    </div>
    <div>
      <h2>An honest note</h2>
      <p class="mt-4">
        We are a new company. We do not have case studies or Government contract wins to show you yet, and we will not pretend otherwise. What we offer is real experience, a clear process, and honest advice from the first call.
      </p>
    </div>
  </section>

  <CtaBand />
</Base>
