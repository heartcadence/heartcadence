---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaBand from '../components/CtaBand.astro';

const guideGroups = [
  {
    heading: 'Technology and customer experience',
    guides: [
      {
        title: 'Phone system buyer checklist',
        text: 'The questions to ask before you switch business phone or contact centre providers.',
      },
      {
        title: 'Service desk health check',
        text: 'A quick way to see how your support desk is doing, based on ITIL practice.',
      },
    ],
  },
  {
    heading: 'Government',
    guides: [
      {
        title: 'Government-ready checklist',
        text: 'A short checklist to see what you have in place, and what is missing, before you bid.',
      },
    ],
  },
];

const official = [
  {
    title: 'Procurement Assistance Canada',
    href: 'https://canada.ca/pac',
    text: 'Free seminars, resources and personalized help from the Government of Canada.',
  },
  {
    title: 'CanadaBuys',
    href: 'https://canadabuys.canada.ca',
    text: 'The Government of Canada’s official site for federal tenders and contract opportunities.',
  },
];
---
<Base title="Technology and Government contract resources" description="Free technology and Government contract guides from Heart Cadence Inc., plus links to official procurement resources.">
  <PageHeader
    eyebrow="Resources"
    title="Free guides to help you get started"
    intro="Practical tools you can use on your own, whether or not you work with us."
  />

  <section class="container-site">
    <h2>Our guides</h2>
    {guideGroups.map((group) => (
      <>
        <h3 class="mt-8 text-xl">{group.heading}</h3>
        <ul class="mt-4 grid gap-4 md:grid-cols-2">
          {group.guides.map((g) => (
            <li class="card-hover rounded-[var(--radius-md)] bg-surface border border-border p-6">
              <p class="text-sm font-semibold uppercase tracking-wider text-text-muted">Coming soon</p>
              <h4 class="mt-1 text-lg">{g.title}</h4>
              <p class="mt-2">{g.text}</p>
            </li>
          ))}
        </ul>
      </>
    ))}
  </section>

  <section class="container-site mt-16">
    <h2>Official Government resources</h2>
    <p class="mt-3 max-w-2xl">These are free Government services. HCI is not part of the Government of Canada.</p>
    <ul class="mt-6 grid gap-4 md:grid-cols-2">
      {official.map((o) => (
        <li class="card-hover rounded-[var(--radius-md)] border border-border p-6">
          <h3><a href={o.href} rel="noopener">{o.title}<span class="sr-only"> (external site)</span></a></h3>
          <p class="mt-2">{o.text}</p>
        </li>
      ))}
    </ul>
  </section>

  <CtaBand />
</Base>
