---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaBand from '../components/CtaBand.astro';
import { scorecards } from '../data/scorecards';

const card = (slug: string) => scorecards.find((s) => s.slug === slug)!;
const guideGroups = [
  { heading: 'Technology and customer experience', guides: [card('phone-system'), card('service-desk')] },
  { heading: 'Government', guides: [card('government-ready')] },
];

const official = [
  {
    title: 'Procurement Assistance Canada',
    href: 'https://canada.ca/pac',
    text: 'Free seminars, resources and personalized help from the Government of Canada.',
  },
  {
    title: 'CanadaBuys',
    href: 'https://canadabuys.canada.ca',
    text: 'The Government of Canada’s official site for federal tenders and contract opportunities.',
  },
];
---
<Base title="Technology and Government contract resources" description="Free technology and Government contract scorecards from Heart Cadence Inc., plus links to official procurement resources.">
  <PageHeader
    eyebrow="Resources"
    title="Free scorecards to help you get started"
    intro="Practical tools you can use on your own, whether or not you work with us."
  />

  <section class="container-site">
    <h2>Our scorecards</h2>
    {guideGroups.map((group) => (
      <>
        <h3 class="mt-8 text-xl">{group.heading}</h3>
        <ul class="mt-4 grid gap-4 md:grid-cols-2">
          {group.guides.map((g) => (
            <li class="card-hover rounded-[var(--radius-md)] bg-surface border border-border p-6 flex flex-col">
              <p class="text-sm font-semibold uppercase tracking-wider text-text-muted">Free scorecard</p>
              <h4 class="mt-1 text-lg">{g.cardTitle}</h4>
              <p class="mt-2">{g.cardText}</p>
              <p class="mt-4"><a href={`/scorecards/${g.slug}/`} class="btn-secondary">Take the scorecard<span class="sr-only">: {g.cardTitle.toLowerCase()}</span></a></p>
            </li>
          ))}
        </ul>
      </>
    ))}
  </section>

  <section class="container-site mt-16">
    <h2>Official Government resources</h2>
    <p class="mt-3 max-w-2xl">These are free Government services. HCI is not part of the Government of Canada.</p>
    <ul class="mt-6 grid gap-4 md:grid-cols-2">
      {official.map((o) => (
        <li class="card-hover rounded-[var(--radius-md)] border border-border p-6">
          <h3><a href={o.href} rel="noopener">{o.title}<span class="sr-only"> (external site)</span></a></h3>
          <p class="mt-2">{o.text}</p>
        </li>
      ))}
    </ul>
  </section>

  <CtaBand />
</Base>
